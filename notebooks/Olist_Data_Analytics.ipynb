    ").reset_index()\n",
    "delivery_review['pct_low'] *= 100\n",
    "delivery_review['pct_orders'] = 100 * delivery_review['count'] / delivery_review['count'].sum()\n",
    "\n",
    "print('=== DELIVERY STATUS vs REVIEW SCORE ===')\n",
    "print(delivery_review.to_string(index=False))\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n",
    "fig.suptitle('Delivery Performance & Customer Satisfaction', fontsize=16,\n",
