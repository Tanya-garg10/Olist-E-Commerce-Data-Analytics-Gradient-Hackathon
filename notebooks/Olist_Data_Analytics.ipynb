   "source": [
    "## 4. 🧹 Data Cleaning & Preparation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 4.1 Datetime Conversion ────────────────────────────────────────────────────\n",
    "date_cols = [\n",
    "    'order_purchase_timestamp', 'order_approved_at',\n",
    "    'order_delivered_carrier_date', 'order_delivered_customer_date',\n",
    "    'order_estimated_delivery_date'\n",
    "]\n",
    "for col in date_cols:\n",
    "    orders[col] = pd.to_datetime(orders[col], errors='coerce')\n",
    "\n",
    "reviews['review_creation_date']     = pd.to_datetime(reviews['review_creation_date'], errors='coerce')\n",
    "reviews['review_answer_timestamp']  = pd.to_datetime(reviews['review_answer_timestamp'], errors='coerce')\n",
    "\n",
    "# ── 4.2 Category Translation ───────────────────────────────────────────────────\n",
    "products = products.merge(cat_trans, on='product_category_name', how='left')\n",
    "products['category_en'] = products['product_category_name_english'].fillna(\n",
    "    products['product_category_name'])\n",
    "\n",
    "# ── 4.3 Delivered Orders Only (for delivery metrics) ──────────────────────────\n",
    "# Only use orders with status='delivered' AND valid delivery date\n",
    "delivered = orders[\n",
    "    (orders['order_status'] == 'delivered') &\n",
    "    (orders['order_delivered_customer_date'].notna()) &\n",
    "    (orders['order_estimated_delivery_date'].notna())\n",
    "].copy()\n",
    "\n",
    "delivered['delivery_days'] = (\n",
    "    delivered['order_delivered_customer_date'] -\n",
    "    delivered['order_purchase_timestamp']\n",
    ").dt.days\n",
    "\n",
    "delivered['delay_days'] = (\n",
    "    delivered['order_delivered_customer_date'] -\n",
    "    delivered['order_estimated_delivery_date']\n",
    ").dt.days\n",
    "\n",
    "# Remove impossible values\n",
    "delivered = delivered[delivered['delivery_days'].between(0, 365)]\n",
    "\n",
    "delivered['delivery_status'] = delivered['delay_days'].apply(\n",
    "    lambda x: 'Early' if x < 0 else ('On Time' if x == 0 else 'Late')\n",
    ")\n",
    "\n",
    "print(f'All orders             : {len(orders):,}')\n",
    "print(f'Delivered (clean)      : {len(delivered):,}')\n",
    "print(f'Delivery status split  :')\n",
    "print(delivered['delivery_status'].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 4.4 Aggregated Datasets ────────────────────────────────────────────────────\n",
    "\n",
    "# Item-level aggregation (one row per order)\n",
    "items_agg = items.groupby('order_id').agg(\n",
    "    item_count    = ('order_item_id', 'count'),\n",
    "    order_revenue = ('price',         'sum'),\n",
    "    freight_total = ('freight_value',  'sum')\n",
    ").reset_index()\n",
    "\n",
    "# Payment aggregation (one row per order)\n",
    "pay_agg = payments.groupby('order_id').agg(\n",
    "    payment_value        = ('payment_value',        'sum'),\n",
    "    payment_installments = ('payment_installments',  'max'),\n",
    "    payment_type         = ('payment_type',          lambda x: x.mode()[0])\n",
    ").reset_index()\n",
    "\n",
    "# Review aggregation (one row per order)\n",
    "rev_agg = reviews.groupby('order_id').agg(\n",
    "    review_score = ('review_score', 'mean')\n",
    ").reset_index()\n",
    "\n",
    "# Geographic aggregation (deduplicate zip codes)\n",
    "geo_agg = geo.groupby('geolocation_zip_code_prefix').agg(\n",
    "    lat   = ('geolocation_lat', 'mean'),\n",
    "    lng   = ('geolocation_lng', 'mean'),\n",
    "    state = ('geolocation_state', 'first')\n",
    ").reset_index()\n",
    "\n",
    "# ── 4.5 Master Analytical Dataset ─────────────────────────────────────────────\n",
    "main = delivered.copy()\n",
    "main = main.merge(items_agg,    on='order_id', how='left')\n",
    "main = main.merge(pay_agg,      on='order_id', how='left')\n",
    "main = main.merge(rev_agg,      on='order_id', how='left')\n",
    "main = main.merge(\n",
    "    customers[['customer_id','customer_unique_id','customer_state','customer_zip_code_prefix']],\n",
    "    on='customer_id', how='left'\n",
    ")\n",
    "\n",
    "# ── 4.6 Item-Level Dataset with Product & Seller Info ─────────────────────────\n",
    "items_full = items.merge(\n",
    "    products[['product_id','product_category_name','category_en']],\n",
    "    on='product_id', how='left'\n",
    ")\n",
    "items_full = items_full.merge(\n",
    "    sellers[['seller_id','seller_state']],\n",
    "    on='seller_id', how='left'\n",
    ")\n",
    "items_full = items_full.merge(rev_agg, on='order_id', how='left')\n",
    "items_full = items_full.merge(\n",
    "    delivered[['order_id','delivery_days','delay_days','delivery_status']],\n",
    "    on='order_id', how='left'\n",
    ")\n",
    "\n",
    "# Time features\n",
    "main['month']    = main['order_purchase_timestamp'].dt.to_period('M')\n",
    "main['year']     = main['order_purchase_timestamp'].dt.year\n",
    "main['quarter']  = main['order_purchase_timestamp'].dt.to_period('Q')\n",
    "main['low_review'] = main['review_score'] <= 2\n",
    "\n",
    "print(f'Master dataset shape   : {main.shape}')\n",
    "print(f'Missing review scores  : {main[\"review_score\"].isna().sum()}')\n",
    "print(f'Missing payment values : {main[\"payment_value\"].isna().sum()}')\n",
    "print('Data preparation complete ✓')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 📈 KPI Overview"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Calculate KPIs ─────────────────────────────────────────────────────────────\n",
    "total_orders        = len(orders)\n",
    "delivered_orders    = len(delivered)\n",
    "total_revenue       = pay_agg[pay_agg['order_id'].isin(delivered['order_id'])]['payment_value'].sum()\n",
    "avg_order_value     = pay_agg[pay_agg['order_id'].isin(delivered['order_id'])]['payment_value'].mean()\n",
    "avg_review_score    = rev_agg[rev_agg['order_id'].isin(delivered['order_id'])]['review_score'].mean()\n",
    "on_time_pct         = 100 * ((delivered['delivery_status']=='Early').sum() + (delivered['delivery_status']=='On Time').sum()) / len(delivered)\n",
    "late_pct            = 100 * (delivered['delivery_status']=='Late').sum() / len(delivered)\n",
    "avg_delivery_days   = delivered['delivery_days'].mean()\n",
    "cancel_unavail      = orders[orders['order_status'].isin(['canceled','unavailable'])]\n",
    "cancel_pct          = 100 * len(cancel_unavail) / total_orders\n",
    "total_sellers       = len(sellers)\n",
    "total_unique_cust   = customers['customer_unique_id'].nunique()\n",
    "total_categories    = products['category_en'].nunique()\n",
    "\n",
    "# ── KPI Display ───────────────────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(3, 4, figsize=(18, 9))\n",
    "fig.patch.set_facecolor('#F8F9FA')\n",
    "\n",
    "kpis = [\n",
    "    ('Total Orders',          f'{total_orders:,}',              BLUE),\n",
    "    ('Delivered Orders',      f'{delivered_orders:,}',           GREEN),\n",
    "    ('Total Revenue',         f'R$ {total_revenue/1e6:.2f}M',    TEAL),\n",
    "    ('Avg Order Value',       f'R$ {avg_order_value:.2f}',       BLUE),\n",
    "    ('Avg Review Score',      f'{avg_review_score:.2f} / 5',     GREEN if avg_review_score>=4 else ORANGE),\n",
    "    ('On-Time Delivery %',    f'{on_time_pct:.1f}%',             GREEN),\n",
    "    ('Late Delivery %',       f'{late_pct:.1f}%',                RED),\n",
    "    ('Avg Delivery Days',     f'{avg_delivery_days:.1f} days',   ORANGE),\n",
    "    ('Cancel / Unavail %',    f'{cancel_pct:.2f}%',              ORANGE),\n",
    "    ('Total Sellers',         f'{total_sellers:,}',              PURPLE),\n",
    "    ('Unique Customers',      f'{total_unique_cust:,}',          PURPLE),\n",
    "    ('Product Categories',    f'{total_categories}',             TEAL),\n",
    "]\n",
    "\n",
    "for ax, (label, value, color) in zip(axes.flatten(), kpis):\n",
    "    ax.set_facecolor('white')\n",
    "    ax.set_xlim(0,1); ax.set_ylim(0,1)\n",
    "    ax.axis('off')\n",
    "    ax.add_patch(plt.Rectangle((0.02,0.02), 0.96, 0.96,\n",
    "                                fill=True, facecolor='white',\n",
    "                                edgecolor=color, linewidth=2.5,\n",
    "                                transform=ax.transAxes, clip_on=False))\n",
    "    ax.text(0.5, 0.62, value, ha='center', va='center', fontsize=20,\n",
    "            fontweight='bold', color=color, transform=ax.transAxes)\n",
    "    ax.text(0.5, 0.28, label, ha='center', va='center', fontsize=9.5,\n",
    "            color=DARK, transform=ax.transAxes)\n",
    "    ax.axhline(y=0.08, xmin=0.05, xmax=0.95, color=color, linewidth=3, alpha=0.4)\n",
    "\n",
    "fig.suptitle('Olist Marketplace — Key Performance Indicators', fontsize=18,\n",
    "             fontweight='bold', color=DARK, y=1.01)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../visuals/charts/01_kpi_overview.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "print(f'\\nTotal Revenue: R$ {total_revenue:,.2f}')\n",
    "print(f'Avg Order Value: R$ {avg_order_value:.2f}')\n",
    "print(f'Avg Review Score: {avg_review_score:.3f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 📅 Marketplace Performance Over Time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Business Question: Is the marketplace growing? Are there trend changes?\n",
    "\n",
    "monthly = main.groupby('month').agg(\n",
    "    orders         = ('order_id',       'count'),\n",
    "    revenue        = ('order_revenue',   'sum'),\n",
    "    avg_order_val  = ('payment_value',   'mean'),\n",
    "    avg_review     = ('review_score',    'mean'),\n",
    "    late_count     = ('delivery_status', lambda x: (x=='Late').sum())\n",
    ").reset_index()\n",
    "monthly['month_str']    = monthly['month'].astype(str)\n",
    "monthly['late_pct']     = 100 * monthly['late_count'] / monthly['orders']\n",
    "monthly['mom_growth']   = monthly['orders'].pct_change() * 100\n",
    "\n",
    "# Remove first/last partial months\n",
    "monthly = monthly.iloc[1:-1].reset_index(drop=True)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(18, 10))\n",
    "fig.suptitle('Marketplace Performance Over Time (Monthly)', fontsize=16,\n",
    "             fontweight='bold', color=DARK)\n",
    "\n",
    "x = range(len(monthly))\n",
    "xticks = list(range(0, len(monthly), 3))\n",
    "xlabels = [monthly['month_str'].iloc[i] for i in xticks]\n",
    "\n",
    "# Chart 1 — Monthly Order Volume\n",
    "ax = axes[0,0]\n",
    "ax.fill_between(x, monthly['orders'], alpha=0.25, color=BLUE)\n",
    "ax.plot(x, monthly['orders'], color=BLUE, linewidth=2.5, marker='o', markersize=4)\n",
    "ax.set_title('Monthly Order Volume', fontweight='bold')\n",
    "ax.set_ylabel('Number of Orders')\n",
    "ax.set_xticks(xticks); ax.set_xticklabels(xlabels, rotation=45, ha='right')\n",
    "# Annotate peak\n",
    "peak_idx = monthly['orders'].idxmax()\n",
    "ax.annotate(f\"Peak: {monthly['orders'].max():,}\\n{monthly['month_str'].iloc[peak_idx]}\",\n",
    "            xy=(peak_idx, monthly['orders'].max()),\n",
    "            xytext=(peak_idx-4, monthly['orders'].max()-800),\n",
    "            arrowprops=dict(arrowstyle='->', color=RED),\n",
    "            fontsize=8.5, color=RED, fontweight='bold')\n",
    "\n",
    "# Chart 2 — Monthly Revenue\n",
    "ax = axes[0,1]\n",
    "ax.fill_between(x, monthly['revenue']/1e3, alpha=0.25, color=GREEN)\n",
    "ax.plot(x, monthly['revenue']/1e3, color=GREEN, linewidth=2.5, marker='o', markersize=4)\n",
    "ax.set_title('Monthly Revenue (R$ thousands)', fontweight='bold')\n",
    "ax.set_ylabel('Revenue (R$ 000s)')\n",
    "ax.set_xticks(xticks); ax.set_xticklabels(xlabels, rotation=45, ha='right')\n",
    "\n",
    "# Chart 3 — Average Review Score\n",
    "ax = axes[1,0]\n",
    "colors_review = [RED if v < 3.8 else GREEN for v in monthly['avg_review']]\n",
    "ax.bar(x, monthly['avg_review'], color=colors_review, alpha=0.8)\n",
    "ax.axhline(y=monthly['avg_review'].mean(), color=BLUE, linestyle='--',\n",
    "           linewidth=1.5, label=f\"Avg: {monthly['avg_review'].mean():.2f}\")\n",
    "ax.set_ylim(3, 5)\n",
    "ax.set_title('Monthly Average Review Score', fontweight='bold')\n",
    "ax.set_ylabel('Avg Review Score (1-5)')\n",
    "ax.set_xticks(xticks); ax.set_xticklabels(xlabels, rotation=45, ha='right')\n",
    "ax.legend()\n",
    "\n",
    "# Chart 4 — Average Order Value\n",
    "ax = axes[1,1]\n",
    "ax.plot(x, monthly['avg_order_val'], color=ORANGE, linewidth=2.5, marker='s', markersize=4)\n",
    "ax.fill_between(x, monthly['avg_order_val'], alpha=0.15, color=ORANGE)\n",
    "ax.set_title('Monthly Average Order Value (R$)', fontweight='bold')\n",
    "ax.set_ylabel('Avg Order Value (R$)')\n",
    "ax.set_xticks(xticks); ax.set_xticklabels(xlabels, rotation=45, ha='right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../visuals/charts/02_marketplace_over_time.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "print('=== KEY TREND OBSERVATIONS ===')\n",
    "print(f\"Peak month by orders : {monthly.loc[monthly['orders'].idxmax(), 'month_str']} ({monthly['orders'].max():,} orders)\")\n",
    "print(f\"Peak month by revenue: {monthly.loc[monthly['revenue'].idxmax(), 'month_str']} (R$ {monthly['revenue'].max():,.0f})\")\n",
