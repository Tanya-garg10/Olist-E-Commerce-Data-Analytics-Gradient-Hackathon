   "source": [
    "## 11. 🔍 Root Cause Analysis — What Drives Low Review Scores?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Business Question: What factors are most strongly ASSOCIATED with low review scores (≤2)?\n",
    "# NOTE: This is associative analysis only — we do not claim causation.\n",
    "\n",
    "low  = main[main['low_review'] == True].copy()\n",
    "high = main[main['low_review'] == False].copy()\n",
    "\n",
    "print(f'Low review orders  (≤2): {len(low):,} ({100*len(low)/len(main):.1f}%)')\n",
    "print(f'High review orders (>2): {len(high):,} ({100*len(high)/len(main):.1f}%)')\n",
    "print()\n",
    "\n",
    "# Factor comparison table\n",
    "factors = {\n",
    "    'Avg Delay Days':          (round(low['delay_days'].mean(),2),    round(high['delay_days'].mean(),2)),\n",
    "    'Avg Delivery Days':       (round(low['delivery_days'].mean(),2),  round(high['delivery_days'].mean(),2)),\n",
    "    'Late Delivery %':         (round(100*(low['delivery_status']=='Late').mean(),2),\n",
    "                                round(100*(high['delivery_status']=='Late').mean(),2)),\n",
    "    'Avg Freight Cost (R$)':   (round(low['freight_total'].mean(),2),  round(high['freight_total'].mean(),2)),\n",
    "    'Avg Order Value (R$)':    (round(low['payment_value'].mean(),2),  round(high['payment_value'].mean(),2)),\n",
    "    'Avg Item Count':          (round(low['item_count'].mean(),2),     round(high['item_count'].mean(),2)),\n",
    "    'Avg Installments':        (round(low['payment_installments'].mean(),2), round(high['payment_installments'].mean(),2)),\n",
    "}\n",
    "\n",
    "factor_df = pd.DataFrame(factors, index=['Low Review (≤2)', 'High Review (>2)']).T\n",
    "factor_df['Difference'] = factor_df['Low Review (≤2)'] - factor_df['High Review (>2)']\n",
    "factor_df['% Difference'] = (100 * factor_df['Difference'] / factor_df['High Review (>2)']).round(1)\n",
    "print('=== FACTOR COMPARISON: LOW vs HIGH REVIEW ORDERS ===')\n",
    "print(factor_df.to_string())"
   ]
