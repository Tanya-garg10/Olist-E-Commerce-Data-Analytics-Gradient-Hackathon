    "\n",
    "datasets = {\n",
    "    'orders': orders, 'order_items': items, 'order_payments': payments,\n",
    "    'order_reviews': reviews, 'customers': customers, 'products': products,\n",
    "    'sellers': sellers, 'geolocation': geo, 'category_translation': cat_trans\n",
    "}\n",
    "\n",
    "print('=== DATASET OVERVIEW ===')\n",
    "for name, df in datasets.items():\n",
    "    nulls = df.isnull().sum().sum()\n",
    "    dups  = df.duplicated().sum()\n",
    "    print(f'{name:30s}  rows={df.shape[0]:>8,}  cols={df.shape[1]:>3}  nulls={nulls:>6,}  dups={dups:>4}')"
   ]
