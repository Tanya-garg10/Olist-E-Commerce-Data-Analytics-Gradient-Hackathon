   "source": [
    "# Business Question: Which sellers drive poor performance? Which states concentrate sellers?\n",
    "\n",
    "seller_perf = items_full.groupby('seller_id').agg(\n",
    "    orders       = ('order_id',         'nunique'),\n",
    "    revenue      = ('price',             'sum'),\n",
    "    avg_review   = ('review_score',      'mean'),\n",
    "    avg_delay    = ('delay_days',        'mean'),\n",
    "    late_pct     = ('delivery_status',   lambda x: 100*(x=='Late').sum()/len(x)),\n",
    "    avg_freight  = ('freight_value',     'mean'),\n",
    "    seller_state = ('seller_state',      'first')\n",
    ").reset_index()\n",
    "\n",
    "# Only sellers with >= 20 orders for fair comparison\n",
    "seller_min = seller_perf[seller_perf['orders'] >= 20].copy()\n",
    "\n",
    "print(f'Total sellers: {len(seller_perf):,}')\n",
    "print(f'Sellers with ≥20 orders: {len(seller_min):,}')\n",
    "print()\n",
    "\n",
    "# Seller segments\n",
    "seller_min['segment'] = 'Average'\n",
    "seller_min.loc[(seller_min['avg_review'] >= 4.3) & (seller_min['orders'] >= 50), 'segment'] = 'Top Performer'\n",
    "seller_min.loc[(seller_min['avg_review'] < 3.5) | (seller_min['late_pct'] > 20), 'segment'] = 'At Risk'\n",
    "seller_min.loc[(seller_min['orders'] >= 100) & (seller_min['avg_review'] < 4.0), 'segment'] = 'High Volume Low Sat'\n",
    "\n",
    "print('Seller segments:')\n",
    "print(seller_min['segment'].value_counts())\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(18, 7))\n",
    "fig.suptitle('Seller Performance Analysis', fontsize=16, fontweight='bold', color=DARK)\n",
    "\n",
    "# Scatter: orders vs avg review (sized by revenue)\n",
    "ax = axes[0]\n",
    "seg_colors = {'Top Performer': GREEN, 'At Risk': RED, 'High Volume Low Sat': ORANGE, 'Average': BLUE}\n",
    "for seg, grp in seller_min.groupby('segment'):\n",
    "    ax.scatter(grp['orders'], grp['avg_review'],\n",
    "               s=np.clip(grp['revenue']/2000, 20, 300),\n",
    "               color=seg_colors[seg], alpha=0.6, label=seg)\n",
    "ax.set_xlabel('Number of Orders')\n",
    "ax.set_ylabel('Average Review Score')\n",
    "ax.set_title('Seller Orders vs Review Score\\n(bubble = revenue)', fontweight='bold')\n",
    "ax.axhline(y=4.07, color=GRAY, linestyle='--', linewidth=1.2, label='Platform Avg')\n",
    "ax.legend(fontsize=8)\n",
    "\n",
    "# Seller state concentration\n",
    "ax = axes[1]\n",
    "state_sellers = seller_perf.groupby('seller_state').agg(\n",
    "    seller_count = ('seller_id', 'count'),\n",
    "    total_orders = ('orders', 'sum')\n",
    ").reset_index().sort_values('seller_count', ascending=False).head(10)\n",
    "ax.bar(state_sellers['seller_state'], state_sellers['seller_count'],\n",
    "       color=PURPLE, alpha=0.8)\n",
    "ax.set_title('Seller Count by State (Top 10)', fontweight='bold')\n",
    "ax.set_xlabel('Seller State')\n",
    "ax.set_ylabel('Number of Sellers')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../visuals/charts/05_seller_analysis.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "print('\\n=== AT-RISK SELLERS (review<3.5 OR late_pct>20%, min 20 orders) ===')\n",
    "at_risk = seller_min[seller_min['segment']=='At Risk'].sort_values('orders', ascending=False)\n",
    "print(at_risk[['seller_id','orders','avg_review','late_pct','seller_state']].head(10).to_string(index=False))"
   ]
